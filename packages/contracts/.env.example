# Copy to packages/contracts/.env (local only: every .env file is git-ignored).
# `npm run deployer:generate -w contracts` creates .env with a fresh DEPLOYER_KEY and prints only the address.

# ---- Deployer ----
# 0x-prefixed 32-byte hex private key of a FRESH wallet. Never the team BridgeKey wallet's key.
DEPLOYER_KEY=

# ---- RPC and explorer (blank = MST's public endpoints) ----
MST_TESTNET_RPC_URL=https://testnetrpc.mstblockchain.com
MST_MAINNET_RPC_URL=https://mariorpc.mstblockchain.com
# mstscan is Blockscout: any non-empty value is accepted.
MSTSCAN_API_KEY=blockscout

# ---- Deployment parameters (read by scripts/deploy.ts and scripts/configure.ts) ----
# Protocol fee receiver: the team BridgeKey wallet (public address only).
TREASURY_ADDRESS=0x820A3a10239C7c480491b96e7b5232d158BB19C1
# Server signer that receives VERIFIER_ROLE (badge mint + EIP-712 ListingAuth) and ARBITER_ROLE.
# Address only; its private key lives in packages/frontend/.env as VERIFIER_PRIVATE_KEY.
SERVER_VERIFIER_ADDRESS=

# Tier limits in wei for tiers New, Trusted, Verified (demo rate 1 tMSTC = Rs 1,00,000:
# Rs 500 / Rs 2,000 / Rs 10,000 = 0.005 / 0.02 / 0.1 tMSTC).
TIER_LIMITS_WEI=5000000000000000,20000000000000000,100000000000000000
# Sharer deposit in basis points by tier (New, Trusted, Verified) and the seeker deposit.
SHARER_DEPOSIT_BPS=5000,3000,2000
SEEKER_DEPOSIT_BPS=500
# Protocol fee in basis points (bounded on-chain to <= 500).
FEE_BPS=200
# Seconds before anyone may apply the 50/50 default ruling to an unresolved dispute.
ARBITER_TIMEOUT_SECONDS=259200

# ---- Tooling ----
# true prints the gas table during `npm run contracts:test`.
REPORT_GAS=false
