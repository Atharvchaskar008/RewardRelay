{
  "name": "@rewardrelay/contracts",
  "description": "SAKAR smart contracts (RelayEscrow, ReputationSBT), tests and deployment scripts.",
  "license": "MIT",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "hardhat node",
    "compile": "hardhat compile",
    "build": "hardhat compile && tsc --noEmit",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "gas": "cross-env REPORT_GAS=true hardhat test test/ReputationSBT.test.ts test/RelayEscrow.smoke.test.ts test/RelayEscrow.lifecycle.test.ts",
    "slither": "hardhat clean && hardhat compile && slither . --config-file slither.config.json",
    "lint": "solhint \"contracts/**/*.sol\" && eslint . --ext .ts",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "configure:local": "hardhat run scripts/configure.ts --network localhost",
    "smoke:local": "hardhat run scripts/smoke.ts --network localhost",
    "deploy:testnet": "hardhat run scripts/deploy.ts --network mstTestnet",
    "deploy:mainnet": "hardhat run scripts/deploy.ts --network mstMainnet",
    "preflight:testnet": "cross-env DRY_RUN=true hardhat run scripts/deploy.ts --network mstTestnet",
    "preflight:mainnet": "cross-env DRY_RUN=true hardhat run scripts/deploy.ts --network mstMainnet",
    "configure:testnet": "hardhat run scripts/configure.ts --network mstTestnet",
    "configure:mainnet": "hardhat run scripts/configure.ts --network mstMainnet",
    "smoke:testnet": "hardhat run scripts/smoke.ts --network mstTestnet",
    "smoke:mainnet": "hardhat run scripts/smoke.ts --network mstMainnet",
    "verify:testnet": "hardhat run scripts/verify.ts --network mstTestnet",
    "verify:mainnet": "hardhat run scripts/verify.ts --network mstMainnet",
    "clean": "hardhat clean",
    "deployer:generate": "ts-node scripts/generate-deployer.ts"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.0.2"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.16.10",
    "@types/prompt-sync": "^4.2.3",
    "chai": "^4.5.0",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.5",
    "ethers": "^6.17.0",
    "hardhat": "^2.22.10",
    "hardhat-gas-reporter": "^1.0.10",
    "prompt-sync": "^4.2.0",
    "solhint": "^5.0.3",
    "solidity-coverage": "^0.8.17",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.5.4"
  }
}
