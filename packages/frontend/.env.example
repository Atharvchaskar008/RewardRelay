# Copy to packages/frontend/.env.local (local only: every .env file is git-ignored).
# Server-side values are validated at boot by src/server/env.ts; the app refuses to start on a bad value.
# NEXT_PUBLIC_* values are bundled into the browser: never put a secret in them.

# ---- Chain (MST Testnet) ----
MST_RPC_URL=https://testnetrpc.mstblockchain.com
MST_CHAIN_ID=91562037
MST_EXPLORER_URL=https://testnet.mstscan.com
# Written by scripts/deploy.ts (H5).
ESCROW_ADDRESS=
SBT_ADDRESS=

# ---- Server signers: fresh keys, 0x-prefixed 32-byte hex, never the BridgeKey wallet ----
# VERIFIER_ROLE + ARBITER_ROLE: mints Trust Badges, signs EIP-712 ListingAuth, resolves disputes.
VERIFIER_PRIVATE_KEY=
# Sends the one-time welcome top-up of TOPUP_WEI.
FUNDER_PRIVATE_KEY=
# Optional dedicated signer for cron auto-release; blank = FUNDER_PRIVATE_KEY.
RELEASER_PRIVATE_KEY=

# ---- Firebase Admin (service account) ----
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# PEM with literal \n sequences; they are converted to newlines at boot.
FIREBASE_PRIVATE_KEY=

# ---- Encryption (each key: 32 random bytes, base64; e.g. `openssl rand -base64 32`) ----
# AES-256-GCM data keys for envelope encryption, as comma-separated keyId:base64 pairs (rotation).
DATA_KEYS=
# Key ID used for new encryptions; must appear in DATA_KEYS.
DATA_KEY_ID=k1
# HMAC-SHA256 keys, deliberately separate: phone-number hashing and code fingerprints.
PHONE_HMAC_KEY=
CODE_HMAC_KEY=

# ---- Access control and automation ----
# Comma-separated Firebase UIDs allowed to use /admin and resolve disputes.
ADMIN_UIDS=
# Shared secret sent by cron-job.org in the X-Cron-Secret header (at least 32 characters).
CRON_SECRET=

# ---- Demo economics (all amounts in wei, never hard-coded) ----
# Demo rate: 1 tMSTC = Rs 1,00,000.
DEMO_RATE_INR_PER_MSTC=100000
# One-time welcome top-up per verified user (e.g. 0.002 tMSTC).
TOPUP_WEI=2000000000000000
# /api/health warns when a server signer holds less than this.
SIGNER_LOW_BALANCE_WEI=10000000000000000

# ---- Uploads ----
# Vercel Blob token for invoices and evidence; blank = Firestore fallback.
BLOB_READ_WRITE_TOKEN=

# ---- Public (browser) values ----
NEXT_PUBLIC_CHAIN_ID=91562037
NEXT_PUBLIC_MSTSCAN_URL=https://testnet.mstscan.com
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional: enables WalletConnect in the wallet picker.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
