{
  "name": "rewardrelay",
  "version": "0.1.0",
  "private": true,
  "description": "A trusted buy-it-for-me marketplace for unused rewards, on MST Blockchain.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Atharvchaskar008/SAKAR.git"
  },
  "workspaces": [
    "packages/shared",
    "packages/contracts",
    "apps/web"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present && npm run format:check",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration -w @rewardrelay/web",
    "dev": "concurrently -k -n chain,web -c blue,green \"npm run dev -w @rewardrelay/contracts\" \"npm run dev -w @rewardrelay/web\"",
    "compile": "npm run compile -w @rewardrelay/contracts",
    "contracts:test": "npm run test -w @rewardrelay/contracts",
    "contracts:coverage": "npm run coverage -w @rewardrelay/contracts",
    "contracts:gas": "npm run gas -w @rewardrelay/contracts",
    "clean": "npm run clean --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "concurrently": "^9.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "prettier-plugin-solidity": "^2.1.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.3.0",
  "overrides": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.32",
    "@grpc/grpc-js": "^1.14.6",
    "@vercel/cli-config": {
      "zod": "^4.6.7"
    },
    "jose": "^5.10.0"
  },
  "prettier": {
    "printWidth": 100,
    "endOfLine": "auto",
    "plugins": [
      "prettier-plugin-solidity"
    ],
    "overrides": [
      {
        "files": "*.sol",
        "options": {
          "tabWidth": 4
        }
      }
    ]
  }
}
