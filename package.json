{
  "name": "rewardrelay",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/contracts",
    "packages/frontend"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present && npm run format:check",
    "test": "npm run test --workspaces --if-present",
    "dev": "concurrently -k -n chain,web -c blue,green \"npm run dev -w contracts\" \"npm run dev -w frontend\"",
    "compile": "npm run compile -w contracts",
    "contracts:test": "npm run test -w contracts",
    "contracts:coverage": "npm run coverage -w contracts",
    "contracts:gas": "npm run gas -w contracts",
    "clean": "npm run clean --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "concurrently": "^9.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "prettier-plugin-solidity": "^2.1.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "packageManager": "npm@11.3.0"
}
