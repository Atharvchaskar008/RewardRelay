{
  "name": "rewardrelay",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/contracts",
    "packages/frontend"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev": "concurrently -k -n chain,web -c blue,green \"npm run dev -w contracts\" \"npm run dev -w frontend\"",
    "compile": "npm run compile -w contracts",
    "contracts:test": "npm run test -w contracts",
    "contracts:coverage": "npm run coverage -w contracts",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "packageManager": "npm@11.3.0"
}
